# Copy to .env and fill in. NEVER commit the real .env.
# AHG36 API key is required ONLY for the full-stock list endpoint (get-products).
# Single-product reads (get-product) are public and need no key.
AHG36_API_KEY=

# AHG36 API base. Override only if the gallery moves to a new host.
AHG36_API_BASE=https://www.ahg36.com/wpactions

# Port the local proxy + SD bridge listens on.
PROXY_PORT=8787

# Stream Diffusion OSC target (TouchDesigner on the operator PC).
# For the public URL this stays as the operator/LAN bridge target.
SD_OSC_HOST=127.0.0.1
SD_OSC_PORT=4035
